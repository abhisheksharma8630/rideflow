# ============================================================
# RideFlow root environment example
# Copy to .env for docker-compose. See per-app .env.example too.
# NEVER commit real secrets.
# ============================================================

# --- PostgreSQL (used by docker-compose and the API) ---
POSTGRES_USER=rideflow
POSTGRES_PASSWORD=rideflow_dev_pw
POSTGRES_DB=rideflow
POSTGRES_PORT=5432

# --- API ---
# Inside docker the API reaches the db via host "db"; locally use localhost.
DATABASE_URL=postgresql://rideflow:rideflow_dev_pw@localhost:5432/rideflow?schema=public
API_PORT=4000
NODE_ENV=development

# JWT (demo only - rotate/replace for production)
JWT_SECRET=change_me_dev_only_secret
JWT_EXPIRES_IN=7d

# Demo login MUST be explicitly enabled; it is force-disabled when NODE_ENV=production.
DEMO_LOGIN_ENABLED=true

# Dispatch / simulation tuning
OFFER_TIMEOUT_SECONDS=20
SIM_TICK_MS=2000

# CORS (comma-separated origins; * allowed in dev)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
