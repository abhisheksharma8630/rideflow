# RideFlow API environment. Copy to .env for local (non-docker) runs.
DATABASE_URL=postgresql://rideflow:rideflow_dev_pw@localhost:5432/rideflow?schema=public
API_PORT=4000
NODE_ENV=development
JWT_SECRET=change_me_dev_only_secret
JWT_EXPIRES_IN=7d
DEMO_LOGIN_ENABLED=true
OFFER_TIMEOUT_SECONDS=20
SIM_TICK_MS=2000
CORS_ORIGINS=*
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
