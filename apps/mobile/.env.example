# RideFlow mobile environment.
# IMPORTANT: on a physical phone, localhost means the PHONE, not your computer.
# Set this to your computer's LAN IP so the device can reach the backend, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:4000
# For an Android emulator use http://10.0.2.2:4000
# For iOS simulator / web, http://localhost:4000 works.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Maps: the app renders a real street map using Leaflet + OpenStreetMap tiles
# inside a WebView. This needs NO API key and works in Expo Go. The key below is
# only a placeholder for a future routing/directions provider (road distance &
# ETA); it is not required for the map to display. When unset, distances remain
# straight-line (haversine) and are labelled "estimated (no routing)".
EXPO_PUBLIC_MAP_PROVIDER_KEY=
